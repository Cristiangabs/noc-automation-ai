# ============================================================================
# TELECOM & NOC INTELLIGENT OPERATIONS SUITE — ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to `.env` inside the respective module directory and replace
# the placeholder values with your environment's credentials.

# ----------------------------------------------------------------------------
# 1. FIELD OPERATIONS PWA & ERP INTEGRATION (01-field-operations-pwa)
# ----------------------------------------------------------------------------
PORT=3000
TZ=America/Caracas

# Odoo ERP PostgreSQL Connection
ODOO_DB_HOST=10.0.10.50
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=YOUR_DB_PASSWORD
ODOO_DB_NAME=isp_production

# SmartOLT GPON/FTTH Provisioning API
SMARTOLT_HOST=isp-domain.smartolt.com
SMARTOLT_API_KEY=YOUR_SMARTOLT_API_TOKEN

# ----------------------------------------------------------------------------
# 2. SOFIA AI NOC COPILOT & NETWORK SENTINEL (02-sofia-ai-noc-copilot)
# ----------------------------------------------------------------------------
SOFIA_PORT=11450
TEST_MODE=false

# Local vLLM / OpenAI-Compatible Inference Server
LLM_BASE_URL=https://10.0.10.40:11443/v1
LLM_API_KEY=Bearer YOUR_LLM_BEARER_TOKEN
LLM_MODEL=agent.fast

# OpenWA WhatsApp API Gateway
OPENWA_BASE_URL=http://10.0.10.20:2785
OPENWA_SESSION_ID=YOUR_OPENWA_SESSION_ID
OPENWA_API_KEY=YOUR_OPENWA_API_KEY
WEBHOOK_URL=http://10.0.10.30:11450/api/sofia-webhook

# Bequant BQN DPI & TCP Shaper (WebSocket TLS)
BQN_HOST=10.0.20.10
BQN_PORT=443
BQN_USER=bqnop
BQN_PASS=YOUR_BQN_PASSWORD

# ICMP Power Outage Sentinel
SENTINEL_ONU_IP=10.0.50.151
SENTINEL_INTERVAL_MS=20000

# Authorized Technical Alert Recipients
REPORT_TARGET_CHAT_ID=584120000001@c.us
TECH_GROUP_IDS=120363000000000001@g.us

# ----------------------------------------------------------------------------
# 3. NOC TELEMETRY PROXY, WALLBOARDS & CHECKERS (03-noc-telemetry-suite)
# ----------------------------------------------------------------------------
PROXY_PORT=11440
SUBSCRIBERS_FILE=./subscribers.json
CA_CERT_PATH=./certs/internal-ca.crt

# Zabbix API (JSON-RPC)
ZABBIX_URL=http://10.0.10.35/zabbix/api_jsonrpc.php
ZABBIX_TOKEN=YOUR_ZABBIX_API_TOKEN

# Proxmox VE Cluster & Datacenter Manager
PROXMOX_HOST=10.0.10.10
PROXMOX_USER=root@pam
PROXMOX_PASS=YOUR_SECURE_PASSWORD

# Carrier WAN & Remote Datacenter Probes
WAN_PRIMARY_IP=198.51.100.10
WAN_BACKUP_IP=203.0.113.10
ROUTER_LOCAL_IP=10.0.10.1
TUNNEL_VPN_IP=10.99.0.1
PROXMOX_NODE_01=10.0.30.80
PROXMOX_NODE_02=10.0.30.81
PROXMOX_NODE_03=10.0.30.83

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
