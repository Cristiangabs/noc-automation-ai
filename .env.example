# ==========================================
# NOC AUTOMATION & AI SUITE - CONFIGURATION
# ==========================================

# Proxy & Webhook Service
PROXY_PORT=11440
SUBSCRIBERS_FILE=./subscribers.json

# Zabbix Monitoring API
ZABBIX_URL=http://zabbix-server.local/zabbix/api_jsonrpc.php
ZABBIX_TOKEN=your_zabbix_api_token_here

# Proxmox VE Cluster API
PROXMOX_HOST=192.168.1.10
PROXMOX_USER=root@pam
PROXMOX_PASS=your_proxmox_password_here

# AI Model Gateway (OpenAI-compatible / LiteLLM / vLLM)
AI_GATEWAY_URL=https://ai-gateway.local:11443
AI_GATEWAY_TOKEN=Bearer your_ai_token_here
CA_CERT_PATH=./multicanal-ca.crt

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
